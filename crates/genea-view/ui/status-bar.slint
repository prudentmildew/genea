// The status bar at the bottom of a project window. Each item is a plain
// string from the core's StatusBar view state.

import { Theme } from "theme.slint";

export component StatusBar inherits Rectangle {
    in property <string> notice;
    // "genea.jsonc has 1 error", while the config has problems (#29).
    in property <string> config-notice;
    // Problem counts over every source, e.g. "1 error  2 warnings"; empty
    // with none.
    in property <string> problems;
    in property <bool> has-errors;
    in property <string> caret;

    // The config notice or the counts were clicked.
    callback show-problems();

    height: 22px;
    background: Theme.chrome-background;

    Rectangle {
        y: 0px;
        height: 1px;
        background: Theme.chrome-border;
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 16px;

        if root.config-notice != "": Text {
            text: root.config-notice;
            color: Theme.warning;
            font-size: Theme.chrome-font-size;
            vertical-alignment: center;

            TouchArea {
                clicked => {
                    root.show-problems();
                }
            }
        }

        Text {
            text: root.notice;
            color: Theme.chrome-muted;
            font-size: Theme.chrome-font-size;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }

        if root.problems != "": Text {
            text: root.problems;
            color: root.has-errors ? Theme.error : Theme.warning;
            font-size: Theme.chrome-font-size;
            vertical-alignment: center;

            TouchArea {
                clicked => {
                    root.show-problems();
                }
            }
        }

        Text {
            text: root.caret;
            color: Theme.chrome-foreground;
            font-size: Theme.chrome-font-size;
            vertical-alignment: center;
        }
    }
}
