// The status bar at the bottom of a project window. Each item is a plain
// string from the core's StatusBar view state.

import { Theme } from "theme.slint";

export component StatusBar inherits Rectangle {
    in property <string> notice;
    // The notice's button label (Retry, …), or empty for none.
    in property <string> notice-action;
    // Toolchain download progress (ticket #35).
    in property <string> toolchain;
    in property <string> caret;
    callback notice-action-clicked();

    height: 22px;
    background: Theme.chrome-background;

    Rectangle {
        y: 0px;
        height: 1px;
        background: Theme.chrome-border;
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 16px;

        Text {
            text: root.notice;
            color: Theme.chrome-muted;
            font-size: Theme.chrome-font-size;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }

        if root.notice-action != "": Text {
            text: root.notice-action;
            color: Theme.chrome-foreground;
            font-size: Theme.chrome-font-size;
            font-weight: 600;
            vertical-alignment: center;

            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.notice-action-clicked();
                }
            }
        }

        Text {
            text: root.toolchain;
            color: Theme.chrome-muted;
            font-size: Theme.chrome-font-size;
            vertical-alignment: center;
        }

        Text {
            text: root.caret;
            color: Theme.chrome-foreground;
            font-size: Theme.chrome-font-size;
            vertical-alignment: center;
        }
    }
}
