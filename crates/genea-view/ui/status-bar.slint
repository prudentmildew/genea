// The status bar at the bottom of a project window. Each item is a plain
// string from the core's StatusBar view state.

import { Theme } from "theme.slint";

export component StatusBar inherits Rectangle {
    in property <string> notice;
    // The notice's button label (Retry, …), or empty for none.
    in property <string> notice-action;
    // "genea.jsonc has 1 error", while the config has problems (#29).
    in property <string> config-notice;
    // Problem counts over every source, e.g. "1 error  2 warnings"; empty
    // with none.
    in property <string> problems;
    in property <bool> has-errors;
    // Toolchain download progress (ticket #35).
    in property <string> toolchain;
    // "Checking project…" while a project check runs (ticket #48).
    in property <string> project-check;
    // The git branch (ticket #56), or empty outside a repository.
    in property <string> branch;
    in property <string> caret;
    in property <string> encoding;
    in property <string> line-ending;
    // The open file's indentation, "2 spaces" or "Tabs" (ticket #26).
    in property <string> indentation;
    // The update notice ("Genea 0.2.0 is available"), or empty.
    in property <string> update;
    // Why the open file has no highlighting: it is over 5 MB (ticket #27).
    in property <string> large-file;
    // The open file's rest is still being read; it is read-only meanwhile.
    in property <bool> loading;
    // The language servers' state, e.g. "TypeScript 7.0.2" (ticket #42).
    in property <string> language-server;
    // A server failed or isn't responding: the item is a warning, and a
    // click restarts it.
    in property <bool> language-server-alert;
    // Running scripts' local URLs (ticket #40); a click opens one.
    in property <[string]> script-links;

    callback notice-action-clicked();
    callback update-clicked();
    // The config notice or the counts were clicked.
    callback show-problems();
    // The language-server item was clicked while it is an alert.
    callback restart-language-server();
    callback script-link-clicked(int);

    height: 22px;
    background: Theme.chrome-background;

    Rectangle {
        y: 0px;
        height: 1px;
        background: Theme.chrome-border;
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 16px;

        if root.config-notice != "": Text {
            text: root.config-notice;
            color: Theme.warning;
            font-size: Theme.chrome-font-size;
            vertical-alignment: center;

            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.show-problems();
                }
            }
        }

        Text {
            text: root.notice;
            color: Theme.chrome-muted;
            font-size: Theme.chrome-font-size;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }

        if root.notice-action != "": Text {
            text: root.notice-action;
            color: Theme.chrome-foreground;
            font-size: Theme.chrome-font-size;
            font-weight: 600;
            vertical-alignment: center;

            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.notice-action-clicked();
                }
            }
        }

        for link[index] in root.script-links: Text {
            text: link;
            color: Theme.link;
            font-size: Theme.chrome-font-size;
            vertical-alignment: center;

            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.script-link-clicked(index);
                }
            }
        }

        if root.language-server != "": Text {
            text: root.language-server;
            color: root.language-server-alert ? Theme.warning : Theme.chrome-muted;
            font-size: Theme.chrome-font-size;
            vertical-alignment: center;

            TouchArea {
                mouse-cursor: root.language-server-alert ? pointer : default;
                clicked => {
                    if root.language-server-alert {
                        root.restart-language-server();
                    }
                }
            }
        }

        if root.project-check != "": Text {
            text: root.project-check;
            color: Theme.chrome-muted;
            font-size: Theme.chrome-font-size;
            vertical-alignment: center;
        }

        Text {
            text: root.toolchain;
            color: Theme.chrome-muted;
            font-size: Theme.chrome-font-size;
            vertical-alignment: center;
        }

        if root.update != "": Text {
            text: root.update;
            color: Theme.link;
            font-size: Theme.chrome-font-size;
            vertical-alignment: center;

            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.update-clicked();
                }
            }
        }

        if root.problems != "": Text {
            text: root.problems;
            color: root.has-errors ? Theme.error : Theme.warning;
            font-size: Theme.chrome-font-size;
            vertical-alignment: center;

            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.show-problems();
                }
            }
        }

        if root.loading: Text {
            text: "Loading…";
            color: Theme.chrome-muted;
            font-size: Theme.chrome-font-size;
            vertical-alignment: center;
        }

        if root.large-file != "": Text {
            text: root.large-file;
            color: Theme.chrome-muted;
            font-size: Theme.chrome-font-size;
            vertical-alignment: center;
        }

        if root.branch != "": Text {
            text: root.branch;
            color: Theme.chrome-foreground;
            font-size: Theme.chrome-font-size;
            vertical-alignment: center;
        }

        Text {
            text: root.caret;
            color: Theme.chrome-foreground;
            font-size: Theme.chrome-font-size;
            vertical-alignment: center;
        }

        Text {
            text: root.indentation;
            color: Theme.chrome-foreground;
            font-size: Theme.chrome-font-size;
            vertical-alignment: center;
        }

        Text {
            text: root.line-ending;
            color: Theme.chrome-foreground;
            font-size: Theme.chrome-font-size;
            vertical-alignment: center;
        }

        Text {
            text: root.encoding;
            color: Theme.chrome-foreground;
            font-size: Theme.chrome-font-size;
            vertical-alignment: center;
        }
    }
}
