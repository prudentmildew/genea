// The left column (spec #19 story 54): a view switcher on top and the active
// view below. Files (⌘1, the one a project opens with), Search (⌘⇧F) and
// Problems (⌘6) are there; Changes joins them in its ticket: add a
// `LeftView` value, a switcher tab and the view itself. The column is collapsed (not shown) while the core's
// `left_column` is `None`.

import { Theme } from "theme.slint";
import { ProblemsView, ProblemRow } from "problems-view.slint";
import { FilesView, FileEntry } from "files-view.slint";
import { SearchView, SearchRow } from "search-view.slint";

export enum LeftView { files, search, problems }

// A tab in the switcher.
component SwitcherTab inherits Rectangle {
    in property <string> label;
    in property <bool> active;

    callback clicked();

    min-width: label-text.preferred-width + 20px;
    background: touch.has-hover && !root.active ? Theme.chrome-highlight : transparent;

    label-text := Text {
        text: root.label;
        color: root.active ? Theme.chrome-foreground : Theme.chrome-muted;
        font-weight: root.active ? 600 : 400;
        vertical-alignment: center;
    }

    Rectangle {
        y: parent.height - 2px;
        height: 2px;
        background: root.active ? Theme.caret : transparent;
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

export component LeftColumn inherits Rectangle {
    in property <LeftView> view;
    in property <[ProblemRow]> problems;
    in property <[FileEntry]> files;
    in property <string> search-query;
    in property <bool> search-regex;
    in property <bool> search-case-sensitive;
    in property <bool> search-whole-word;
    in property <[SearchRow]> search-rows;
    in property <string> search-status;
    in property <bool> search-status-error;

    // A switcher tab was clicked: show that view.
    callback show(LeftView);
    callback problem-clicked(int);
    callback file-clicked(int);
    callback search(text: string, regex: bool, case-sensitive: bool, whole-word: bool);
    callback search-result-clicked(int);

    background: Theme.chrome-background;

    VerticalLayout {
        Rectangle {
            height: 28px;

            HorizontalLayout {
                padding-left: 4px;
                alignment: start;

                SwitcherTab {
                    label: "Files";
                    active: root.view == LeftView.files;
                    clicked => {
                        root.show(LeftView.files);
                    }
                }

                SwitcherTab {
                    label: "Search";
                    active: root.view == LeftView.search;
                    clicked => {
                        root.show(LeftView.search);
                    }
                }

                SwitcherTab {
                    label: "Problems";
                    active: root.view == LeftView.problems;
                    clicked => {
                        root.show(LeftView.problems);
                    }
                }
            }

            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Theme.chrome-border;
            }
        }

        if root.view == LeftView.files: FilesView {
            vertical-stretch: 1;
            files: root.files;
            clicked(index) => {
                root.file-clicked(index);
            }
        }

        if root.view == LeftView.search: SearchView {
            vertical-stretch: 1;
            query: root.search-query;
            regex: root.search-regex;
            case-sensitive: root.search-case-sensitive;
            whole-word: root.search-whole-word;
            rows: root.search-rows;
            status: root.search-status;
            status-error: root.search-status-error;
            search(text, regex, case-sensitive, whole-word) => {
                root.search(text, regex, case-sensitive, whole-word);
            }
            clicked(index) => {
                root.search-result-clicked(index);
            }
        }

        if root.view == LeftView.problems: ProblemsView {
            vertical-stretch: 1;
            problems: root.problems;
            clicked(index) => {
                root.problem-clicked(index);
            }
        }
    }
}
