// The left column (spec #19 story 54): a view switcher on top and the active
// view below. Files (⌘1, the one a project opens with), Changes (#53) and
// Problems (⌘6) are there; Search joins them in its ticket: add a
// `LeftView` value, a switcher tab and the view itself. The column is collapsed (not shown) while the core's
// `left_column` is `None`.

import { Theme } from "theme.slint";
import { ProblemsView, ProblemRow } from "problems-view.slint";
import { FilesView, FileEntry } from "files-view.slint";
import { ChangesView, ChangeRow } from "changes-view.slint";

export enum LeftView { files, changes, problems }

// A tab in the switcher.
component SwitcherTab inherits Rectangle {
    in property <string> label;
    in property <bool> active;

    callback clicked();

    min-width: label-text.preferred-width + 20px;
    background: touch.has-hover && !root.active ? Theme.chrome-highlight : transparent;

    label-text := Text {
        text: root.label;
        color: root.active ? Theme.chrome-foreground : Theme.chrome-muted;
        font-weight: root.active ? 600 : 400;
        vertical-alignment: center;
    }

    Rectangle {
        y: parent.height - 2px;
        height: 2px;
        background: root.active ? Theme.caret : transparent;
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

export component LeftColumn inherits Rectangle {
    in property <LeftView> view;
    in property <[ProblemRow]> problems;
    in property <[FileEntry]> files;
    in property <[ChangeRow]> changes;

    // A switcher tab was clicked: show that view.
    callback show(LeftView);
    callback problem-clicked(int);
    callback file-clicked(int);
    // The Changes view's row, its Keep and Revert, and Keep All, Revert All.
    callback change-clicked(int);
    callback keep-change(int);
    callback revert-change(int);
    callback keep-all-changes();
    callback revert-all-changes();

    background: Theme.chrome-background;

    VerticalLayout {
        Rectangle {
            height: 28px;

            HorizontalLayout {
                padding-left: 4px;
                alignment: start;

                SwitcherTab {
                    label: "Files";
                    active: root.view == LeftView.files;
                    clicked => {
                        root.show(LeftView.files);
                    }
                }

                SwitcherTab {
                    label: root.changes.length == 0 ? "Changes" : "Changes (" + root.changes.length + ")";
                    active: root.view == LeftView.changes;
                    clicked => {
                        root.show(LeftView.changes);
                    }
                }

                SwitcherTab {
                    label: "Problems";
                    active: root.view == LeftView.problems;
                    clicked => {
                        root.show(LeftView.problems);
                    }
                }
            }

            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Theme.chrome-border;
            }
        }

        if root.view == LeftView.files: FilesView {
            vertical-stretch: 1;
            files: root.files;
            clicked(index) => {
                root.file-clicked(index);
            }
        }

        if root.view == LeftView.changes: ChangesView {
            vertical-stretch: 1;
            changes: root.changes;
            clicked(index) => {
                root.change-clicked(index);
            }
            keep(index) => {
                root.keep-change(index);
            }
            revert(index) => {
                root.revert-change(index);
            }
            keep-all => {
                root.keep-all-changes();
            }
            revert-all => {
                root.revert-all-changes();
            }
        }

        if root.view == LeftView.problems: ProblemsView {
            vertical-stretch: 1;
            problems: root.problems;
            clicked(index) => {
                root.problem-clicked(index);
            }
        }
    }
}
