// Colours, fonts and metrics shared by every view: the built-in light and
// dark themes (spec #19 story 57), each with its syntax highlight colours. A
// window follows the system's appearance live (Slint's winit backend sets
// `Palette.color-scheme` from the window's theme and updates it when macOS
// switches) unless its project's config pins `theme` (ticket #29): Rust sets
// `follow-system` and `pinned-dark` per window (src/window.rs). Each window
// has its own instance of this global.
//
// The editor font is Menlo 13 pt with a line height of 1.2 (spec #19). Keep
// line-height in step with LINE_HEIGHT in src/surface.rs.

import { Palette } from "std-widgets.slint";

export global Theme {
    // The config's `theme`: "system" follows the system's appearance;
    // "light" and "dark" pin one.
    in-out property <bool> follow-system: true;
    in-out property <bool> pinned-dark: false;
    out property <bool> dark: root.follow-system ? Palette.color-scheme == ColorScheme.dark : root.pinned-dark;

    out property <string> editor-font: "Menlo";
    out property <length> editor-font-size: 13px;
    out property <length> line-height: 15.6px;
    // Line numbers, then git markers (#56), then fold markers (#25).
    out property <length> gutter-width: 64px;

    out property <color> editor-background: root.dark ? #0d1117 : #ffffff;
    out property <color> editor-foreground: root.dark ? #e6edf3 : #24292f;
    out property <color> gutter-foreground: root.dark ? #6e7681 : #9a9a9a;
    out property <color> caret: root.dark ? #58a6ff : #1f6feb;
    out property <color> selection: root.dark ? #264f78 : #b6d6fd;
    // The bracket at the caret and its match (ticket #25).
    out property <color> bracket-match: root.dark ? #3fb95033 : #2da44e26;
    out property <color> bracket-match-border: root.dark ? #3fb950aa : #2da44e99;
    // A collapsed fold's placeholder after its first line.
    out property <color> fold-placeholder: root.dark ? #30363d : #eaeef2;
    // Underlines and markers for problems.
    out property <color> error: root.dark ? #f85149 : #cf222e;
    out property <color> warning: root.dark ? #d29922 : #9a6700;
    // Git gutter markers (ticket #56): lines added, modified and deleted
    // against HEAD.
    out property <color> git-added: root.dark ? #3fb950 : #1a7f37;
    out property <color> git-modified: root.dark ? #58a6ff : #0969da;
    out property <color> git-deleted: root.dark ? #f85149 : #cf222e;
    // The background of a change's lines at HEAD in its popover.
    out property <color> git-head-background: root.dark ? #2d1517 : #ffebe9;
    // The inline diff (ticket #55): the rows of added and removed lines,
    // and the removed lines' text.
    out property <color> diff-added-background: root.dark ? #12261e : #e6ffec;
    out property <color> diff-removed-background: root.dark ? #2d1517 : #ffebe9;
    out property <color> diff-removed-foreground: root.dark ? #b1bac4 : #57606a;

    out property <color> chrome-background: root.dark ? #161b22 : #f6f8fa;
    out property <color> chrome-border: root.dark ? #30363d : #d0d7de;
    out property <color> chrome-foreground: root.dark ? #e6edf3 : #24292f;
    out property <color> chrome-muted: root.dark ? #8b949e : #57606a;
    // A selected or hovered row in a list.
    out property <color> chrome-highlight: root.dark ? #21262d : #eaeef2;
    out property <color> link: root.dark ? #4493f8 : #0969da;
    // A script that finished (ticket #40's status dot).
    out property <color> success: root.dark ? #3fb950 : #1a7f37;
    out property <length> chrome-font-size: 12px;

    // The terminal (ticket #38), indexed by `TermRun.fg-index` and
    // `bg-index` (src/terminal.rs): its foreground, its background, then
    // the 16 ANSI colours (black, red, green, yellow, blue, magenta, cyan,
    // white, then the bright ones).
    out property <[color]> terminal-palette: root.dark ? [
        #e6edf3, #0d1117,
        #484f58, #ff7b72, #3fb950, #d29922, #58a6ff, #bc8cff, #39c5cf, #b1bac4,
        #6e7681, #ffa198, #56d364, #e3b341, #79c0ff, #d2a8ff, #56d4dd, #ffffff,
    ] : [
        #24292f, #ffffff,
        #24292f, #cf222e, #116329, #4d2d00, #0969da, #8250df, #1b7c83, #6e7781,
        #57606a, #a40e26, #1a7f37, #633c01, #218bff, #a475f9, #3192aa, #8c959f,
    ];
    // The block cursor, see-through so the character under it shows.
    out property <color> terminal-cursor: root.dark ? #58a6ff80 : #1f6feb66;

    // Highlight colours, indexed by `Run.highlight`. The order is
    // `highlight_index` in src/surface.rs: 0 is plain text, then one entry per
    // `genea_core::Highlight`.
    out property <[color]> syntax: root.dark ? [
        #e6edf3, // plain
        #8b949e, // comment
        #ff7b72, // keyword
        #e6edf3, // operator
        #c9d1d9, // punctuation
        #a5d6ff, // string
        #7ee787, // string special (regex, colour)
        #79c0ff, // escape
        #79c0ff, // number
        #79c0ff, // constant
        #d2a8ff, // function
        #ffa657, // constructor
        #ffa657, // type
        #79c0ff, // built-in type
        #e6edf3, // variable
        #79c0ff, // built-in variable
        #ffa657, // parameter
        #79c0ff, // property
        #7ee787, // tag
        #79c0ff, // attribute
        #ffa657, // label
        #79c0ff, // heading
        #d2a8ff, // emphasis
        #ffa657, // strong
        #a5d6ff, // link
        #a5d6ff, // literal
        #6e7681, // inlay hint, code lens (#46)
    ] : [
        #24292f, // plain
        #6e7781, // comment
        #cf222e, // keyword
        #24292f, // operator
        #57606a, // punctuation
        #0a3069, // string
        #116329, // string special (regex, colour)
        #0550ae, // escape
        #0550ae, // number
        #0550ae, // constant
        #8250df, // function
        #953800, // constructor
        #953800, // type
        #0550ae, // built-in type
        #24292f, // variable
        #0550ae, // built-in variable
        #953800, // parameter
        #0550ae, // property
        #116329, // tag
        #0550ae, // attribute
        #953800, // label
        #0550ae, // heading
        #8250df, // emphasis
        #953800, // strong
        #0a3069, // link
        #0a3069, // literal
        #8c959f, // inlay hint, code lens (#46)
    ];
}
