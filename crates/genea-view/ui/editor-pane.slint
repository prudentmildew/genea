// One side of the editor area (ticket #31): a tab strip over an editor
// surface. A project window has one, or two side by side after a split.
// Rust (src/window.rs) sets every property from the core's PaneView.

import { Theme } from "theme.slint";
import { EditorSurface, Line, HunkPopup, QuickFixPopup } from "editor-surface.slint";
import { AssistPopups } from "assist-popups.slint";

// A tab in the strip.
export struct TabEntry {
    title: string,
    // The file has unsaved edits.
    modified: bool,
    active: bool,
}

// The inline diff's bar (ticket #55), set by Rust from the pane's
// EditorView::inline_diff.
export struct DiffBar {
    shown: bool,
    // What the file is compared with.
    label: string,
    // Keep and Revert apply: the file is listed in Changes.
    can-keep: bool,
    can-revert: bool,
}

// Where the surface's lines, caret and preedit are, placed by Rust.
export struct SurfaceGeometry {
    offset-y: length,
    caret-x: length,
    caret-y: length,
    compose-x: length,
    preedit-width: length,
}

export component EditorPane inherits Rectangle {
    in property <[TabEntry]> tabs;
    // This side has the keyboard focus: its active tab is marked.
    in property <bool> focused;
    in property <bool> has-editor;
    in property <bool> can-split;
    in property <[Line]> lines <=> surface.lines;
    in property <SurfaceGeometry> geometry;
    in property <HunkPopup> hunk <=> surface.hunk;
    in property <QuickFixPopup> quick-fixes <=> surface.quick-fixes;
    in property <AssistPopups> assist <=> surface.assist;
    // The file changed on disk while it had unsaved edits (ticket #32):
    // the conflict bar shows over the top of the editor.
    in property <bool> conflict;
    // The file shows as an inline diff (ticket #55): a small bar at the
    // top right offers Keep, Revert and closing the diff.
    in property <DiffBar> diff-bar;

    out property <length> char-width: surface.char-width;
    out property <length> viewport-height: surface.viewport-height;
    out property <length> text-left: surface.text-left;

    callback tab-clicked(index: int);
    callback tab-closed(index: int);
    callback tab-moved(index: int);
    callback split-right();
    // The conflict bar's buttons: Reload (`reload`) or Keep my edits.
    callback conflict-resolved(reload: bool);
    // The diff bar's buttons.
    callback diff-kept();
    callback diff-reverted();
    callback diff-closed();

    callback scrolled <=> surface.scrolled;
    callback pressed <=> surface.pressed;
    callback dragged <=> surface.dragged;
    callback double-clicked <=> surface.double-clicked;
    callback key <=> surface.key;
    callback committed <=> surface.committed;
    callback preedit-changed <=> surface.preedit-changed;
    callback rollback-hunk <=> surface.rollback-hunk;
    callback hide-hunk <=> surface.hide-hunk;
    callback quick-fix-clicked <=> surface.quick-fix-clicked;
    callback completion-clicked <=> surface.completion-clicked;
    callback pointer-moved <=> surface.pointer-moved;
    callback pointer-left <=> surface.pointer-left;

    public function refocus() {
        surface.refocus();
    }

    background: Theme.editor-background;
    forward-focus: surface;

    VerticalLayout {
        Rectangle {
            height: 28px;
            background: Theme.chrome-background;

            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Theme.chrome-border;
            }

            HorizontalLayout {
                alignment: start;

                for tab[index] in root.tabs: ContextMenuArea {
                    Menu {
                        MenuItem {
                            title: "Close Tab";
                            activated => {
                                root.tab-closed(index);
                            }
                        }

                        MenuItem {
                            title: "Move to Other Side";
                            activated => {
                                root.tab-moved(index);
                            }
                        }

                        MenuItem {
                            title: "Split Right";
                            enabled: root.can-split && tab.active && root.focused;
                            activated => {
                                root.split-right();
                            }
                        }
                    }

                    Rectangle {
                        background: tab.active ? Theme.editor-background : Theme.chrome-background;

                        Rectangle {
                            x: parent.width - 1px;
                            width: 1px;
                            background: Theme.chrome-border;
                        }

                        // The focused side's active tab.
                        Rectangle {
                            y: 0px;
                            height: 2px;
                            background: Theme.caret;
                            visible: tab.active && root.focused;
                        }

                        select := TouchArea {
                            clicked => {
                                root.tab-clicked(index);
                            }
                        }

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 6px;
                            spacing: 6px;

                            Text {
                                text: tab.title;
                                color: tab.active ? Theme.chrome-foreground : Theme.chrome-muted;
                                vertical-alignment: center;
                            }

                            // A dot marks unsaved edits; it turns into the
                            // close button under the pointer.
                            Rectangle {
                                width: 16px;

                                close := TouchArea {
                                    clicked => {
                                        root.tab-closed(index);
                                    }
                                }

                                Text {
                                    text: close.has-hover || (select.has-hover && !tab.modified) ? "×" : tab.modified ? "●" : "";
                                    color: close.has-hover ? Theme.chrome-foreground : Theme.chrome-muted;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }
        }

        Rectangle {
            vertical-stretch: 1;

            surface := EditorSurface {
                caret-visible: root.has-editor;
                offset-y: root.geometry.offset-y;
                caret-x: root.geometry.caret-x;
                caret-y: root.geometry.caret-y;
                compose-x: root.geometry.compose-x;
                preedit-width: root.geometry.preedit-width;
            }

            if !root.has-editor: Text {
                text: "Open a file with File › Open File…";
                color: Theme.chrome-muted;
                font-size: 13px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            // The inline diff's bar: over the surface's top right corner,
            // like the conflict bar over its top.
            if root.has-editor && root.diff-bar.shown && !root.conflict: Rectangle {
                x: parent.width - self.width - 16px;
                y: 6px;
                width: bar.preferred-width;
                height: 26px;
                background: Theme.chrome-background;
                border-width: 1px;
                border-color: Theme.chrome-border;
                border-radius: 4px;

                // Clicks between the buttons don't reach the text below.
                TouchArea {
                    mouse-cursor: default;
                }

                bar := HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 8px;
                    spacing: 12px;

                    Text {
                        text: root.diff-bar.label;
                        color: Theme.chrome-muted;
                        vertical-alignment: center;
                    }

                    if root.diff-bar.can-keep: Text {
                        text: "Keep";
                        color: keep.has-hover ? Theme.link : Theme.chrome-foreground;
                        font-weight: 600;
                        vertical-alignment: center;

                        keep := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.diff-kept();
                            }
                        }
                    }

                    if root.diff-bar.can-revert: Text {
                        text: "Revert";
                        color: revert.has-hover ? Theme.link : Theme.chrome-foreground;
                        font-weight: 600;
                        vertical-alignment: center;

                        revert := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.diff-reverted();
                            }
                        }
                    }

                    Text {
                        text: "×";
                        color: close-diff.has-hover ? Theme.chrome-foreground : Theme.chrome-muted;
                        vertical-alignment: center;

                        close-diff := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.diff-closed();
                            }
                        }
                    }
                }
            }

            // Over the surface rather than above it, so the pane's height
            // (and the core's one viewport) doesn't change with it.
            if root.has-editor && root.conflict: Rectangle {
                y: 0px;
                height: 30px;
                background: Theme.chrome-highlight;

                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    background: Theme.chrome-border;
                }

                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 16px;

                    Text {
                        text: "This file changed on disk, and you have unsaved edits.";
                        color: Theme.warning;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }

                    Text {
                        text: "Reload";
                        color: Theme.chrome-foreground;
                        font-weight: 600;
                        vertical-alignment: center;

                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.conflict-resolved(true);
                            }
                        }
                    }

                    Text {
                        text: "Keep my edits";
                        color: Theme.chrome-foreground;
                        font-weight: 600;
                        vertical-alignment: center;

                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.conflict-resolved(false);
                            }
                        }
                    }
                }
            }
        }
    }
}
