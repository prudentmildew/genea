// A project window: the native menu bar (muda), a tab strip, the editor
// surface and the status bar. Every property is set from Rust (src/window.rs)
// out of the core's ProjectView; every callback turns input into a command.

import { Theme } from "theme.slint";
import { EditorSurface, Line } from "editor-surface.slint";
import { StatusBar } from "status-bar.slint";
import { LeftColumn, LeftView } from "left-column.slint";
import { ProblemRow } from "problems-view.slint";

export component ProjectWindow inherits Window {
    in property <string> window-title: "Genea";
    in property <bool> has-editor;
    in property <string> tab-title;
    // The open file has unsaved edits.
    in property <bool> tab-modified;
    in property <string> status-caret;
    in property <string> status-notice;
    in property <string> status-config-notice;
    in property <string> status-problems;
    in property <bool> status-has-errors;

    // The left column: shown while `left-column-visible`, with `left-view`.
    in property <bool> left-column-visible;
    in property <LeftView> left-view;
    in property <[ProblemRow]> problems;

    in property <[Line]> lines <=> surface.lines;
    in property <length> offset-y <=> surface.offset-y;
    in property <length> caret-x <=> surface.caret-x;
    in property <length> caret-y <=> surface.caret-y;
    in property <length> compose-x <=> surface.compose-x;
    in property <length> preedit-width <=> surface.preedit-width;
    out property <length> char-width: surface.char-width;
    out property <length> viewport-height: surface.viewport-height;
    out property <length> text-left: surface.text-left;

    // Menu commands.
    callback open-folder();
    callback open-file();
    callback save();
    callback cut();
    callback copy();
    callback paste();
    callback select-all();
    callback show-about();
    callback open-config();
    // A left-column view's shortcut: show it, or collapse the column.
    callback toggle-view(LeftView);
    // Show a left-column view (a switcher tab, the status-bar notice).
    callback show-view(LeftView);
    callback problem-clicked(int);

    // Editor input.
    callback scrolled <=> surface.scrolled;
    callback pressed <=> surface.pressed;
    callback dragged <=> surface.dragged;
    callback double-clicked <=> surface.double-clicked;
    callback key <=> surface.key;
    callback committed <=> surface.committed;
    callback preedit-changed <=> surface.preedit-changed;
    callback viewport-changed();

    title: root.window-title;
    preferred-width: 1200px;
    preferred-height: 800px;
    background: Theme.editor-background;
    default-font-size: Theme.chrome-font-size;
    forward-focus: surface;

    changed viewport-height => {
        root.viewport-changed();
    }

    // Re-focuses the hidden TextInput once the native window exists, so the
    // IME is enabled (ADR 0004).
    public function refocus() {
        surface.refocus();
    }

    MenuBar {
        Menu {
            title: "File";
            MenuItem {
                title: "Open…";
                shortcut: @keys(Control + O);
                activated => {
                    root.open-folder();
                }
            }

            // Temporary until the Files view (ticket #20 allows it).
            MenuItem {
                title: "Open File…";
                activated => {
                    root.open-file();
                }
            }

            MenuItem {
                title: "Open Config";
                activated => {
                    root.open-config();
                }
            }

            MenuItem {
                title: "Save";
                shortcut: @keys(Control + S);
                enabled: root.has-editor;
                activated => {
                    root.save();
                }
            }
        }

        Menu {
            title: "Edit";
            MenuItem {
                title: "Cut";
                shortcut: @keys(Control + X);
                enabled: root.has-editor;
                activated => {
                    root.cut();
                }
            }

            MenuItem {
                title: "Copy";
                shortcut: @keys(Control + C);
                enabled: root.has-editor;
                activated => {
                    root.copy();
                }
            }

            MenuItem {
                title: "Paste";
                shortcut: @keys(Control + V);
                enabled: root.has-editor;
                activated => {
                    root.paste();
                }
            }

            MenuItem {
                title: "Select All";
                shortcut: @keys(Control + A);
                enabled: root.has-editor;
                activated => {
                    root.select-all();
                }
            }
        }

        Menu {
            title: "View";
            MenuItem {
                title: "Problems";
                shortcut: @keys(Control + "6");
                activated => {
                    root.toggle-view(LeftView.problems);
                }
            }
        }

        Menu {
            title: "Help";
            MenuItem {
                title: "About Genea";
                activated => {
                    root.show-about();
                }
            }
        }
    }

    VerticalLayout {
        HorizontalLayout {
            vertical-stretch: 1;

            if root.left-column-visible: LeftColumn {
                width: 300px;
                view: root.left-view;
                problems: root.problems;
                show(view) => {
                    root.show-view(view);
                }
                problem-clicked(index) => {
                    root.problem-clicked(index);
                }
            }

            if root.left-column-visible: Rectangle {
                width: 1px;
                background: Theme.chrome-border;
            }

            editor-column := VerticalLayout {
                tabs := Rectangle {
                    height: 28px;
                    background: Theme.chrome-background;

                    Rectangle {
                        y: parent.height - 1px;
                        height: 1px;
                        background: Theme.chrome-border;
                    }

                    Text {
                        x: 12px;
                        // A dot marks unsaved edits.
                        text: !root.has-editor ? "" : root.tab-modified ? root.tab-title + "  ●" : root.tab-title;
                        color: Theme.chrome-foreground;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    vertical-stretch: 1;

                    surface := EditorSurface {
                        caret-visible: root.has-editor;
                    }

                    if !root.has-editor: Text {
                        text: "Open a file with File › Open File…";
                        color: Theme.chrome-muted;
                        font-size: 13px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        StatusBar {
            notice: root.status-notice;
            config-notice: root.status-config-notice;
            problems: root.status-problems;
            has-errors: root.status-has-errors;
            caret: root.status-caret;
            show-problems => {
                root.show-view(LeftView.problems);
            }
        }
    }
}
