// A project window: the native menu bar (muda), the editor area (one pane
// of tabs, or two side by side after a split) and the status bar. Every property is set from Rust (src/window.rs)
// out of the core's ProjectView; every callback turns input into a command.

import { Theme } from "theme.slint";
import { Line } from "editor-surface.slint";
import { EditorPane, TabEntry, SurfaceGeometry } from "editor-pane.slint";
import { StatusBar } from "status-bar.slint";
import { LeftColumn, LeftView } from "left-column.slint";
import { ProblemRow } from "problems-view.slint";
import { ToolchainPicker, PickerRow } from "toolchain-picker.slint";
import { FileEntry } from "files-view.slint";
import { ChangeRow } from "changes-view.slint";

export component ProjectWindow inherits Window {
    in property <string> window-title: "Genea";
    // The focused tab has a file: the editing menu items work.
    in property <bool> has-editor;
    in property <string> status-caret;
    in property <string> status-notice;
    in property <string> status-config-notice;
    in property <string> status-problems;
    in property <bool> status-has-errors;

    // The left column: shown while `left-column-visible`, with `left-view`.
    in property <bool> left-column-visible;
    in property <LeftView> left-view;
    in property <[ProblemRow]> problems;
    in property <[FileEntry]> files;
    // The Changes view's rows, and the review banner's text (ticket #53),
    // empty while nothing changed outside Genea.
    in property <[ChangeRow]> changes;
    in property <string> review-banner;
    in property <string> status-encoding;
    in property <string> status-line-ending;
    in property <string> status-notice-action;
    in property <string> status-toolchain;
    in property <string> status-update;
    // Why a large file has no highlighting (ticket #27), or empty.
    in property <string> status-large-file;
    // The focused file's rest is still being read.
    in property <bool> status-loading;

    // The toolchain picker (ticket #37), shown while `picker-visible`.
    in property <bool> picker-visible;
    in property <string> picker-title;
    in property <string> picker-message;
    in property <bool> picker-loading;
    in property <[PickerRow]> picker-options;

    // The editor area (ticket #31): the left pane, and the right one while
    // split. `focused-pane` is 0 (left) or 1 (right).
    in property <bool> split;
    in property <int> focused-pane;
    in property <bool> can-split;
    in property <[TabEntry]> left-tabs;
    in property <[TabEntry]> right-tabs;
    in property <bool> left-has-editor;
    in property <bool> right-has-editor;
    in property <[Line]> left-lines <=> left.lines;
    in property <[Line]> right-lines <=> right.lines;
    in property <SurfaceGeometry> left-geometry;
    in property <SurfaceGeometry> right-geometry;
    // Each pane's file changed on disk while it had unsaved edits (#32).
    in property <bool> left-conflict;
    in property <bool> right-conflict;
    // Both panes have the same font and height.
    out property <length> char-width: left.char-width;
    out property <length> viewport-height: left.viewport-height;
    out property <length> text-left: left.text-left;

    // Menu commands.
    callback open-folder();
    callback save();
    callback undo();
    callback redo();
    callback cut();
    callback copy();
    callback paste();
    callback select-all();
    callback reload-environment();
    // Toolchain commands (ticket #37).
    callback set-runtime();
    callback set-package-manager();
    callback update-toolchain();
    callback remove-unused-toolchains();
    callback picker-filter-edited(string);
    callback picker-picked(int);
    callback picker-cancelled();
    callback show-about();
    callback open-config();
    // A left-column view's shortcut: show it, or collapse the column.
    callback toggle-view(LeftView);
    // Show a left-column view (a switcher tab, the status-bar notice).
    callback show-view(LeftView);
    callback problem-clicked(int);
    // A Files view row: open the file, or expand or collapse the folder.
    callback file-clicked(int);
    // Review (ticket #53): a Changes row, its Keep and Revert, and Keep All
    // and Revert All (from the Changes view or the banner).
    callback change-clicked(int);
    callback keep-change(int);
    callback revert-change(int);
    callback keep-all-changes();
    callback revert-all-changes();
    callback close-tab();
    callback split-right();
    callback move-tab();
    callback close-split();
    callback next-tab(forward: bool);
    // The status-bar notice's button.
    callback notice-action();
    // Opens the release page of the update notice.
    callback open-update();

    // Tab strips; `pane` is 0 (left) or 1 (right).
    callback tab-clicked(pane: int, index: int);
    callback tab-closed(pane: int, index: int);
    callback tab-moved(pane: int, index: int);
    // A pane's conflict bar: Reload (`reload`) or Keep my edits.
    callback conflict-resolved(pane: int, reload: bool);

    // Editor input. Keys, commits and the preedit come from the focused
    // pane only, so they carry no pane.
    callback scrolled(pane: int, delta-y: length);
    callback pressed(pane: int, x: length, y: length, shift: bool, alt: bool);
    callback dragged(pane: int, x: length, y: length);
    callback double-clicked(pane: int, x: length, y: length);
    callback key(text: string, shift: bool, cmd: bool, alt: bool, ctrl: bool);
    callback committed(text: string);
    callback preedit-changed(text: string);
    callback viewport-changed();

    title: root.window-title;
    preferred-width: 1200px;
    preferred-height: 800px;
    background: Theme.editor-background;
    default-font-size: Theme.chrome-font-size;
    forward-focus: left;

    changed viewport-height => {
        root.viewport-changed();
    }

    // Re-focuses the focused pane's hidden TextInput: once the native
    // window exists, so the IME is enabled (ADR 0004), and whenever the
    // core moves the focus to the other pane.
    public function refocus() {
        if root.focused-pane == 1 {
            right.refocus();
        } else {
            left.refocus();
        }
    }

    MenuBar {
        Menu {
            title: "File";
            MenuItem {
                title: "Open…";
                shortcut: @keys(Control + O);
                activated => {
                    root.open-folder();
                }
            }

            MenuItem {
                title: "Open Config";
                activated => {
                    root.open-config();
                }
            }

            MenuItem {
                title: "Save";
                shortcut: @keys(Control + S);
                enabled: root.has-editor;
                activated => {
                    root.save();
                }
            }

            MenuItem {
                title: "Close Tab";
                shortcut: @keys(Control + W);
                enabled: root.has-editor;
                activated => {
                    root.close-tab();
                }
            }

            MenuSeparator { }

            // Re-runs the login shell for the project's environment (#36).
            MenuItem {
                title: "Reload Environment";
                activated => {
                    root.reload-environment();
                }
            }

            MenuSeparator { }

            // The toolchain pickers and upkeep (ticket #37, ADR 0005).
            MenuItem {
                title: "Set Runtime…";
                activated => {
                    root.set-runtime();
                }
            }

            MenuItem {
                title: "Set Package Manager…";
                activated => {
                    root.set-package-manager();
                }
            }

            MenuItem {
                title: "Update Toolchain…";
                activated => {
                    root.update-toolchain();
                }
            }

            MenuItem {
                title: "Remove Unused Toolchains";
                activated => {
                    root.remove-unused-toolchains();
                }
            }
        }

        Menu {
            title: "Edit";
            MenuItem {
                title: "Undo";
                shortcut: @keys(Control + Z);
                enabled: root.has-editor;
                activated => {
                    root.undo();
                }
            }

            MenuItem {
                title: "Redo";
                shortcut: @keys(Control + Shift + Z);
                enabled: root.has-editor;
                activated => {
                    root.redo();
                }
            }

            MenuSeparator { }

            MenuItem {
                title: "Cut";
                shortcut: @keys(Control + X);
                enabled: root.has-editor;
                activated => {
                    root.cut();
                }
            }

            MenuItem {
                title: "Copy";
                shortcut: @keys(Control + C);
                enabled: root.has-editor;
                activated => {
                    root.copy();
                }
            }

            MenuItem {
                title: "Paste";
                shortcut: @keys(Control + V);
                enabled: root.has-editor;
                activated => {
                    root.paste();
                }
            }

            MenuItem {
                title: "Select All";
                shortcut: @keys(Control + A);
                enabled: root.has-editor;
                activated => {
                    root.select-all();
                }
            }
        }

        Menu {
            title: "View";
            MenuItem {
                title: "Files";
                shortcut: @keys(Control + "1");
                activated => {
                    root.toggle-view(LeftView.files);
                }
            }

            MenuItem {
                title: "Changes";
                activated => {
                    root.toggle-view(LeftView.changes);
                }
            }

            MenuItem {
                title: "Problems";
                shortcut: @keys(Control + "6");
                activated => {
                    root.toggle-view(LeftView.problems);
                }
            }
        }

        Menu {
            title: "Window";
            MenuItem {
                title: "Split Right";
                enabled: root.can-split;
                activated => {
                    root.split-right();
                }
            }

            MenuItem {
                title: "Move Tab to Other Side";
                enabled: root.has-editor;
                activated => {
                    root.move-tab();
                }
            }

            MenuItem {
                title: "Close Split";
                enabled: root.split;
                activated => {
                    root.close-split();
                }
            }

            MenuItem {
                title: "Select Next Tab";
                shortcut: @keys(Control + Shift + "]");
                enabled: root.has-editor;
                activated => {
                    root.next-tab(true);
                }
            }

            MenuItem {
                title: "Select Previous Tab";
                shortcut: @keys(Control + Shift + "[");
                enabled: root.has-editor;
                activated => {
                    root.next-tab(false);
                }
            }
        }

        Menu {
            title: "Help";
            MenuItem {
                title: "About Genea";
                activated => {
                    root.show-about();
                }
            }
        }
    }

    VerticalLayout {
        // The review banner: shown while files changed outside Genea.
        if root.review-banner != "": Rectangle {
            height: 30px;
            background: Theme.chrome-highlight;

            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Theme.chrome-border;
            }

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 16px;

                Text {
                    text: root.review-banner;
                    color: Theme.warning;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }

                for action[index] in ["Review", "Keep All", "Revert All"]: Text {
                    text: action;
                    color: banner-touch.has-hover ? Theme.link : Theme.chrome-foreground;
                    font-weight: 600;
                    vertical-alignment: center;

                    banner-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            if index == 0 {
                                root.show-view(LeftView.changes);
                            } else if index == 1 {
                                root.keep-all-changes();
                            } else {
                                root.revert-all-changes();
                            }
                        }
                    }
                }
            }
        }

        HorizontalLayout {
            vertical-stretch: 1;

            if root.left-column-visible: LeftColumn {
                width: 300px;
                view: root.left-view;
                problems: root.problems;
                files: root.files;
                changes: root.changes;
                change-clicked(index) => {
                    root.change-clicked(index);
                }
                keep-change(index) => {
                    root.keep-change(index);
                }
                revert-change(index) => {
                    root.revert-change(index);
                }
                keep-all-changes => {
                    root.keep-all-changes();
                }
                revert-all-changes => {
                    root.revert-all-changes();
                }
                show(view) => {
                    root.show-view(view);
                }
                problem-clicked(index) => {
                    root.problem-clicked(index);
                }
                file-clicked(index) => {
                    root.file-clicked(index);
                }
            }

            if root.left-column-visible: Rectangle {
                width: 1px;
                background: Theme.chrome-border;
            }

            left := EditorPane {
                horizontal-stretch: 1;
                tabs: root.left-tabs;
                focused: root.focused-pane == 0;
                has-editor: root.left-has-editor;
                can-split: root.can-split;
                geometry: root.left-geometry;
                conflict: root.left-conflict;
                conflict-resolved(reload) => {
                    root.conflict-resolved(0, reload);
                }
                tab-clicked(index) => {
                    root.tab-clicked(0, index);
                }
                tab-closed(index) => {
                    root.tab-closed(0, index);
                }
                tab-moved(index) => {
                    root.tab-moved(0, index);
                }
                split-right => {
                    root.split-right();
                }
                scrolled(delta-y) => {
                    root.scrolled(0, delta-y);
                }
                pressed(x, y, shift, alt) => {
                    root.pressed(0, x, y, shift, alt);
                }
                dragged(x, y) => {
                    root.dragged(0, x, y);
                }
                double-clicked(x, y) => {
                    root.double-clicked(0, x, y);
                }
                key(text, shift, cmd, alt, ctrl) => {
                    root.key(text, shift, cmd, alt, ctrl);
                }
                committed(text) => {
                    root.committed(text);
                }
                preedit-changed(text) => {
                    root.preedit-changed(text);
                }
            }

            Rectangle {
                width: 1px;
                background: Theme.chrome-border;
                visible: root.split;
            }

            right := EditorPane {
                horizontal-stretch: 1;
                visible: root.split;
                tabs: root.right-tabs;
                focused: root.focused-pane == 1;
                has-editor: root.right-has-editor;
                can-split: root.can-split;
                geometry: root.right-geometry;
                conflict: root.right-conflict;
                conflict-resolved(reload) => {
                    root.conflict-resolved(1, reload);
                }
                tab-clicked(index) => {
                    root.tab-clicked(1, index);
                }
                tab-closed(index) => {
                    root.tab-closed(1, index);
                }
                tab-moved(index) => {
                    root.tab-moved(1, index);
                }
                split-right => {
                    root.split-right();
                }
                scrolled(delta-y) => {
                    root.scrolled(1, delta-y);
                }
                pressed(x, y, shift, alt) => {
                    root.pressed(1, x, y, shift, alt);
                }
                dragged(x, y) => {
                    root.dragged(1, x, y);
                }
                double-clicked(x, y) => {
                    root.double-clicked(1, x, y);
                }
                key(text, shift, cmd, alt, ctrl) => {
                    root.key(text, shift, cmd, alt, ctrl);
                }
                committed(text) => {
                    root.committed(text);
                }
                preedit-changed(text) => {
                    root.preedit-changed(text);
                }
            }
        }

        StatusBar {
            notice: root.status-notice;
            config-notice: root.status-config-notice;
            problems: root.status-problems;
            has-errors: root.status-has-errors;
            notice-action: root.status-notice-action;
            notice-action-clicked => {
                root.notice-action();
            }
            toolchain: root.status-toolchain;
            caret: root.status-caret;
            encoding: root.status-encoding;
            line-ending: root.status-line-ending;
            update: root.status-update;
            large-file: root.status-large-file;
            loading: root.status-loading;
            update-clicked => {
                root.open-update();
            }
            show-problems => {
                root.show-view(LeftView.problems);
            }
        }
    }

    // A click outside the picker closes it.
    if root.picker-visible: TouchArea {
        clicked => {
            root.picker-cancelled();
        }
    }

    if root.picker-visible: ToolchainPicker {
        x: (root.width - self.width) / 2;
        y: 40px;
        width: min(440px, root.width - 32px);
        height: min(440px, root.height - 80px);
        title: root.picker-title;
        message: root.picker-message;
        loading: root.picker-loading;
        options: root.picker-options;
        init => {
            self.focus-filter();
        }
        filter-edited(text) => {
            root.picker-filter-edited(text);
        }
        picked(index) => {
            root.picker-picked(index);
        }
        cancelled => {
            root.picker-cancelled();
        }
    }
}
