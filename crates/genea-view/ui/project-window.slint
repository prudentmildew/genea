// A project window: the native menu bar (muda), the editor area (one pane
// of tabs, or two side by side after a split), the terminal pane on the
// right or at the bottom (tickets #38, #39) and the status bar. Every property is set from Rust (src/window.rs)
// out of the core's ProjectView; every callback turns input into a command.

import { Theme } from "theme.slint";
import { Line, HunkPopup, QuickFixPopup } from "editor-surface.slint";
import { AssistPopups } from "assist-popups.slint";
import { EditorPane, TabEntry, SurfaceGeometry } from "editor-pane.slint";
import { StatusBar } from "status-bar.slint";
import { LeftColumn, LeftView } from "left-column.slint";
import { ScriptRow } from "scripts-view.slint";
import { ProblemRow } from "problems-view.slint";
import { TerminalPane, TermRow, TermCursor, TermTab } from "terminal-pane.slint";
import { ToolchainPicker, PickerRow } from "toolchain-picker.slint";
import { FileEntry } from "files-view.slint";
import { ChangeRow } from "changes-view.slint";
import { SearchRow } from "search-view.slint";
import { Finder, FinderRow } from "finder.slint";
import { NavigationAction, RenamePrompt } from "navigation.slint";

// What the finder finds (the core's FinderMode).
export enum FinderKind { files, recent-files, actions, everywhere, file-symbols, project-symbols }

// The Code menu's items (ticket #25).
export enum StructuralAction {
    toggle-line-comment,
    expand-fold,
    collapse-fold,
    expand-all-folds,
    collapse-all-folds,
}

export component ProjectWindow inherits Window {
    in property <string> window-title: "Genea";
    // The focused tab has a file: the editing menu items work.
    in property <bool> has-editor;
    in property <string> status-caret;
    in property <string> status-notice;
    in property <string> status-config-notice;
    in property <string> status-problems;
    in property <bool> status-has-errors;

    // The left column: shown while `left-column-visible`, with `left-view`.
    in property <bool> left-column-visible;
    in property <LeftView> left-view;
    in property <[ProblemRow]> problems;
    in property <[FileEntry]> files;
    // The Changes view's rows, and the review banner's text (ticket #53),
    // empty while nothing changed outside Genea.
    in property <[ChangeRow]> changes;
    in property <string> review-banner;
    // The Search view: the core's query and options, and its results.
    in property <string> search-query;
    in property <bool> search-regex;
    in property <bool> search-case-sensitive;
    in property <bool> search-whole-word;
    in property <[SearchRow]> search-rows;
    in property <string> search-status;
    in property <bool> search-status-error;
    // The Usages view and the rename prompt (ticket #44).
    in property <bool> has-usages;
    in property <string> usages-title;
    in property <string> usages-status;
    in property <[SearchRow]> usages-rows;
    in property <bool> rename-open;
    in property <string> rename-name;
    in property <string> status-encoding;
    in property <string> status-line-ending;
    in property <string> status-indentation;
    in property <string> status-notice-action;
    in property <string> status-toolchain;
    // "Checking project…" while a project check runs (ticket #48).
    in property <string> status-project-check;
    in property <string> status-update;
    // The git branch (ticket #56), or empty outside a repository.
    in property <string> status-branch;
    // Why a large file has no highlighting (ticket #27), or empty.
    in property <string> status-large-file;
    // The focused file's rest is still being read.
    in property <bool> status-loading;
    // The language servers' status-bar item (ticket #42).
    in property <string> status-language-server;
    in property <bool> status-language-server-alert;

    // The toolchain picker (ticket #37), shown while `picker-visible`.
    in property <bool> picker-visible;
    in property <string> picker-title;
    in property <string> picker-message;
    in property <bool> picker-loading;
    in property <[PickerRow]> picker-options;

    // The fuzzy finder overlay (ticket #33), while `finder-open`.
    in property <bool> finder-open;
    in property <string> finder-title;
    in property <[FinderRow]> finder-items;
    in property <int> finder-selected;
    in-out property <string> finder-query <=> finder.query;

    // The editor area (ticket #31): the left pane, and the right one while
    // split. `focused-pane` is 0 (left) or 1 (right).
    in property <bool> split;
    in property <int> focused-pane;
    in property <bool> can-split;
    in property <[TabEntry]> left-tabs;
    in property <[TabEntry]> right-tabs;
    in property <bool> left-has-editor;
    in property <bool> right-has-editor;
    in property <[Line]> left-lines <=> left.lines;
    in property <[Line]> right-lines <=> right.lines;
    in property <SurfaceGeometry> left-geometry;
    in property <SurfaceGeometry> right-geometry;
    // The shown git change, in the focused pane only.
    in property <HunkPopup> left-hunk;
    in property <HunkPopup> right-hunk;
    // The quick-fix popup (ticket #45), shown in the focused pane only.
    in property <QuickFixPopup> left-quick-fixes;
    in property <QuickFixPopup> right-quick-fixes;
    // Completion, hover and signature help (ticket #43), in the focused
    // pane only.
    in property <AssistPopups> left-assist;
    in property <AssistPopups> right-assist;
    // Each pane's file changed on disk while it had unsaved edits (#32).
    in property <bool> left-conflict;
    in property <bool> right-conflict;
    // Both panes have the same font and height.
    out property <length> char-width: left.char-width;
    out property <length> viewport-height: left.viewport-height;
    out property <length> text-left: left.text-left;

    // The terminal pane (tickets #38, #39). Its width (on the right) and
    // height (at the bottom) are the view's own: the splitter drags them.
    // `terminal-bottom` follows the config's `terminalPosition`.
    in property <bool> terminal-visible: true;
    in property <bool> terminal-bottom;
    in property <bool> terminal-focused;
    in property <[TermTab]> terminal-tabs;
    in property <string> terminal-message;
    in property <[TermRow]> terminal-rows;
    in property <TermCursor> terminal-cursor;
    in property <bool> terminal-mouse-reporting;
    // The showing terminal tab's Stop, Re-run and link (ticket #40).
    in property <bool> terminal-command-tab;
    in property <bool> terminal-running;
    in property <string> terminal-url;
    // The Scripts view's rows, and the status bar's script links.
    in property <[ScriptRow]> scripts;
    in property <[string]> status-script-links;
    in-out property <length> terminal-width: 520px;
    in-out property <length> terminal-height: 260px;
    out property <length> terminal-char-width: terminal.char-width;
    out property <length> terminal-grid-width: terminal.grid-width;
    out property <length> terminal-grid-height: terminal.grid-height;

    // Menu commands.
    callback open-folder();
    // Opens the New Project dialog (#61).
    callback new-project();
    callback save();
    callback undo();
    callback redo();
    callback cut();
    callback copy();
    callback paste();
    callback select-all();
    callback reload-environment();
    callback install-dependencies();
    callback restart-language-server();
    callback run-project-check();
    // The Code menu's structural editing items (ticket #25).
    callback structural(StructuralAction);
    // Toolchain commands (ticket #37).
    callback set-runtime();
    callback set-package-manager();
    callback update-toolchain();
    callback remove-unused-toolchains();
    callback picker-filter-edited(string);
    callback picker-picked(int);
    callback picker-cancelled();
    callback show-about();
    callback open-config();
    // A left-column view's shortcut: show it, or collapse the column.
    callback toggle-view(LeftView);
    // Show a left-column view (a switcher tab, the status-bar notice).
    callback show-view(LeftView);
    callback problem-clicked(int);
    // A Files view row: open the file, or expand or collapse the folder.
    callback file-clicked(int);
    // Review (ticket #53): a Changes row, its Keep and Revert, and Keep All
    // and Revert All (from the Changes view or the banner).
    callback change-clicked(int);
    callback keep-change(int);
    callback revert-change(int);
    callback keep-all-changes();
    callback revert-all-changes();
    // The Search view's query or options changed.
    callback search(text: string, regex: bool, case-sensitive: bool, whole-word: bool);
    // A Search view row: open the file, at the match for a match row.
    callback search-result-clicked(int);
    // Code navigation and rename (ticket #44).
    callback navigate(NavigationAction);
    callback usage-clicked(int);
    callback rename-accepted(string);
    callback rename-cancelled();
    callback close-tab();
    callback split-right();
    callback move-tab();
    callback close-split();
    callback next-tab(forward: bool);
    // The status-bar notice's button.
    callback notice-action();
    // Opens the release page of the update notice.
    callback open-update();

    // The terminal pane.
    callback toggle-terminal();
    callback terminal-focus();
    callback terminal-tab-clicked(index: int);
    callback terminal-key(text: string, shift: bool, cmd: bool, alt: bool, ctrl: bool);
    callback terminal-committed(text: string);
    callback terminal-preedit-changed(text: string);
    callback terminal-mouse(kind: int, button: int, x: length, y: length, shift: bool, alt: bool, ctrl: bool, cmd: bool);
    callback terminal-scrolled(delta-y: length, x: length, y: length);
    callback terminal-size-changed();
    callback new-terminal-tab();
    callback terminal-tab-closed(index: int);
    // Script runner (ticket #40).
    callback stop-terminal-tab();
    callback rerun-terminal-tab();
    callback open-terminal-url();
    callback script-clicked(int);
    callback script-link-clicked(int);

    // The finder: a shortcut opens it; the rest come from the overlay.
    callback open-finder(FinderKind);
    callback finder-edited(string);
    callback finder-move(int);
    callback finder-accept();
    callback finder-close();
    callback finder-clicked(int);

    // Tab strips; `pane` is 0 (left) or 1 (right).
    callback tab-clicked(pane: int, index: int);
    callback tab-closed(pane: int, index: int);
    callback tab-moved(pane: int, index: int);
    // A pane's conflict bar: Reload (`reload`) or Keep my edits.
    callback conflict-resolved(pane: int, reload: bool);

    // Editor input. Keys, commits and the preedit come from the focused
    // pane only, so they carry no pane.
    callback scrolled(pane: int, delta-y: length);
    callback pressed(pane: int, x: length, y: length, shift: bool, alt: bool);
    callback dragged(pane: int, x: length, y: length);
    callback double-clicked(pane: int, x: length, y: length);
    callback key(text: string, shift: bool, cmd: bool, alt: bool, ctrl: bool);
    callback committed(text: string);
    callback preedit-changed(text: string);
    callback viewport-changed();
    // The shown git change's buttons (ticket #56).
    callback rollback-hunk();
    callback hide-hunk();
    // Quick fixes and organize imports (ticket #45): the Code menu's items
    // and a click on a fix in the popup.
    callback show-quick-fixes();
    callback organize-imports();
    callback quick-fix-clicked(int);
    // A click on a completion; the pointer moving over a pane's text and
    // leaving it (ticket #43).
    callback completion-clicked(index: int);
    callback pointer-moved(pane: int, x: length, y: length);
    callback pointer-left(pane: int);

    title: root.window-title;
    preferred-width: 1200px;
    preferred-height: 800px;
    background: Theme.editor-background;
    default-font-size: Theme.chrome-font-size;
    forward-focus: left;

    changed viewport-height => {
        root.viewport-changed();
    }
    changed terminal-grid-width => {
        root.terminal-size-changed();
    }
    changed terminal-grid-height => {
        root.terminal-size-changed();
    }

    // Gives the finder's query the keyboard focus, when it opens.
    public function focus-finder() {
        finder.focus-query();
    }

    // Re-focuses the focused pane's hidden TextInput: once the native
    // window exists, so the IME is enabled (ADR 0004), and whenever the
    // core moves the focus to the other pane.
    public function refocus() {
        if root.terminal-focused {
            terminal.refocus();
        } else if root.focused-pane == 1 {
            right.refocus();
        } else {
            left.refocus();
        }
    }

    MenuBar {
        Menu {
            title: "File";
            MenuItem {
                title: "Open…";
                shortcut: @keys(Control + O);
                activated => {
                    root.open-folder();
                }
            }

            MenuItem {
                title: "New Project…";
                activated => {
                    root.new-project();
                }
            }

            MenuItem {
                title: "Open Config";
                activated => {
                    root.open-config();
                }
            }

            MenuItem {
                title: "Save";
                shortcut: @keys(Control + S);
                enabled: root.has-editor;
                activated => {
                    root.save();
                }
            }

            MenuItem {
                title: "Close Tab";
                shortcut: @keys(Control + W);
                enabled: root.has-editor || root.terminal-focused;
                activated => {
                    root.close-tab();
                }
            }

            MenuSeparator { }

            // Re-runs the login shell for the project's environment (#36).
            MenuItem {
                title: "Reload Environment";
                activated => {
                    root.reload-environment();
                }
            }

            // The pinned package manager's install, in a terminal tab (#41).
            MenuItem {
                title: "Install Dependencies";
                activated => {
                    root.install-dependencies();
                }
            }

            // Stops and starts tsgo, also after it failed (#42).
            MenuItem {
                title: "Restart Language Server";
                activated => {
                    root.restart-language-server();
                }
            }

            // `tsc -b --noEmit` over the whole project (#48).
            MenuItem {
                title: "Run Project Check";
                activated => {
                    root.run-project-check();
                }
            }

            MenuSeparator { }

            // The toolchain pickers and upkeep (ticket #37, ADR 0005).
            MenuItem {
                title: "Set Runtime…";
                activated => {
                    root.set-runtime();
                }
            }

            MenuItem {
                title: "Set Package Manager…";
                activated => {
                    root.set-package-manager();
                }
            }

            MenuItem {
                title: "Update Toolchain…";
                activated => {
                    root.update-toolchain();
                }
            }

            MenuItem {
                title: "Remove Unused Toolchains";
                activated => {
                    root.remove-unused-toolchains();
                }
            }
        }

        Menu {
            title: "Edit";
            MenuItem {
                title: "Undo";
                shortcut: @keys(Control + Z);
                enabled: root.has-editor;
                activated => {
                    root.undo();
                }
            }

            MenuItem {
                title: "Redo";
                shortcut: @keys(Control + Shift + Z);
                enabled: root.has-editor;
                activated => {
                    root.redo();
                }
            }

            MenuSeparator { }

            MenuItem {
                title: "Cut";
                shortcut: @keys(Control + X);
                enabled: root.has-editor;
                activated => {
                    root.cut();
                }
            }

            MenuItem {
                title: "Copy";
                shortcut: @keys(Control + C);
                enabled: root.has-editor;
                activated => {
                    root.copy();
                }
            }

            MenuItem {
                title: "Paste";
                shortcut: @keys(Control + V);
                enabled: root.has-editor;
                activated => {
                    root.paste();
                }
            }

            MenuItem {
                title: "Select All";
                shortcut: @keys(Control + A);
                enabled: root.has-editor;
                activated => {
                    root.select-all();
                }
            }
        }

        // Structural editing (ticket #25). Expand and Shrink Selection
        // (⌥↑ / ⌥↓) are keys, not menu items, so the clone-caret gesture
        // (⌥⌥↑) still gets the arrows.
        Menu {
            title: "Code";
            // WebStorm's Show Context Actions and Optimize Imports keys.
            MenuItem {
                title: "Show Quick Fixes";
                shortcut: @keys(Alt + Return);
                enabled: root.has-editor;
                activated => {
                    root.show-quick-fixes();
                }
            }

            MenuItem {
                title: "Organize Imports";
                shortcut: @keys(Meta + Alt + O);
                enabled: root.has-editor;
                activated => {
                    root.organize-imports();
                }
            }

            MenuItem {
                title: "Comment with Line Comment";
                shortcut: @keys(Control + "/");
                enabled: root.has-editor;
                activated => {
                    root.structural(StructuralAction.toggle-line-comment);
                }
            }

            Menu {
                title: "Folding";
                // ⌘+ and ⌘− are zoom's (#13); these are WebStorm's
                // Expand and Collapse Recursively keys.
                MenuItem {
                    title: "Expand";
                    shortcut: @keys(Control + Alt + "=");
                    enabled: root.has-editor;
                    activated => {
                        root.structural(StructuralAction.expand-fold);
                    }
                }

                MenuItem {
                    title: "Collapse";
                    shortcut: @keys(Control + Alt + "-");
                    enabled: root.has-editor;
                    activated => {
                        root.structural(StructuralAction.collapse-fold);
                    }
                }

                MenuItem {
                    title: "Expand All";
                    enabled: root.has-editor;
                    activated => {
                        root.structural(StructuralAction.expand-all-folds);
                    }
                }

                MenuItem {
                    title: "Collapse All";
                    enabled: root.has-editor;
                    activated => {
                        root.structural(StructuralAction.collapse-all-folds);
                    }
                }
            }
        }

        Menu {
            title: "View";
            MenuItem {
                title: "Files";
                shortcut: @keys(Control + "1");
                activated => {
                    root.toggle-view(LeftView.files);
                }
            }

            MenuItem {
                title: "Search";
                shortcut: @keys(Control + Shift + F);
                activated => {
                    root.toggle-view(LeftView.search);
                }
            }

            MenuItem {
                title: "Changes";
                activated => {
                    root.toggle-view(LeftView.changes);
                }
            }

            MenuItem {
                title: "Problems";
                shortcut: @keys(Control + "6");
                activated => {
                    root.toggle-view(LeftView.problems);
                }
            }

            MenuItem {
                title: "Scripts";
                activated => {
                    root.toggle-view(LeftView.scripts);
                }
            }

            MenuItem {
                title: "Terminal";
                shortcut: @keys(Alt + F12);
                activated => {
                    root.toggle-terminal();
                }
            }

            MenuItem {
                title: "New Terminal Tab";
                shortcut: @keys(Control + T);
                activated => {
                    root.new-terminal-tab();
                }
            }
        }

        Menu {
            title: "Navigate";
            MenuItem {
                title: "Go to File…";
                shortcut: @keys(Control + Shift + O);
                activated => {
                    root.open-finder(FinderKind.files);
                }
            }

            MenuItem {
                title: "Recent Files";
                shortcut: @keys(Control + E);
                activated => {
                    root.open-finder(FinderKind.recent-files);
                }
            }

            MenuItem {
                title: "Find Action…";
                shortcut: @keys(Control + Shift + A);
                activated => {
                    root.open-finder(FinderKind.actions);
                }
            }

            // Its shortcut is ⇧⇧ (src/keys.rs), which a menu can't show.
            MenuItem {
                title: "Search Everywhere";
                activated => {
                    root.open-finder(FinderKind.everywhere);
                }
            }

            // Symbols from tsgo (ticket #47).
            MenuItem {
                title: "File Structure";
                shortcut: @keys(Control + F12);
                activated => {
                    root.open-finder(FinderKind.file-symbols);
                }
            }

            MenuItem {
                title: "Go to Symbol…";
                shortcut: @keys(Control + Alt + O);
                activated => {
                    root.open-finder(FinderKind.project-symbols);
                }
            }

            MenuSeparator { }

            // Through the language server (ticket #44).
            MenuItem {
                title: "Go to Definition";
                shortcut: @keys(Control + B);
                enabled: root.has-editor;
                activated => {
                    root.navigate(NavigationAction.definition);
                }
            }

            MenuItem {
                title: "Go to Type Definition";
                shortcut: @keys(Control + Shift + B);
                enabled: root.has-editor;
                activated => {
                    root.navigate(NavigationAction.type-definition);
                }
            }

            MenuItem {
                title: "Go to Implementation";
                shortcut: @keys(Control + Alt + B);
                enabled: root.has-editor;
                activated => {
                    root.navigate(NavigationAction.implementation);
                }
            }

            MenuItem {
                title: "Find Usages";
                shortcut: @keys(Alt + F7);
                enabled: root.has-editor;
                activated => {
                    root.navigate(NavigationAction.usages);
                }
            }
        }

        Menu {
            title: "Refactor";
            MenuItem {
                title: "Rename…";
                shortcut: @keys(Shift + F6);
                enabled: root.has-editor;
                activated => {
                    root.navigate(NavigationAction.rename);
                }
            }
        }

        Menu {
            title: "Window";
            MenuItem {
                title: "Split Right";
                enabled: root.can-split;
                activated => {
                    root.split-right();
                }
            }

            MenuItem {
                title: "Move Tab to Other Side";
                enabled: root.has-editor;
                activated => {
                    root.move-tab();
                }
            }

            MenuItem {
                title: "Close Split";
                enabled: root.split;
                activated => {
                    root.close-split();
                }
            }

            MenuItem {
                title: "Select Next Tab";
                shortcut: @keys(Control + Shift + "]");
                enabled: root.has-editor || root.terminal-focused;
                activated => {
                    root.next-tab(true);
                }
            }

            MenuItem {
                title: "Select Previous Tab";
                shortcut: @keys(Control + Shift + "[");
                enabled: root.has-editor || root.terminal-focused;
                activated => {
                    root.next-tab(false);
                }
            }
        }

        Menu {
            title: "Help";
            MenuItem {
                title: "About Genea";
                activated => {
                    root.show-about();
                }
            }
        }
    }

    VerticalLayout {
        // The review banner: shown while files changed outside Genea.
        if root.review-banner != "": Rectangle {
            height: 30px;
            background: Theme.chrome-highlight;

            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Theme.chrome-border;
            }

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 16px;

                Text {
                    text: root.review-banner;
                    color: Theme.warning;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }

                for action[index] in ["Review", "Keep All", "Revert All"]: Text {
                    text: action;
                    color: banner-touch.has-hover ? Theme.link : Theme.chrome-foreground;
                    font-weight: 600;
                    vertical-alignment: center;

                    banner-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            if index == 0 {
                                root.show-view(LeftView.changes);
                            } else if index == 1 {
                                root.keep-all-changes();
                            } else {
                                root.revert-all-changes();
                            }
                        }
                    }
                }
            }
        }

        // The editor area and the terminal pane, placed by hand so the
        // pane can move between the right and the bottom.
        content := Rectangle {
            vertical-stretch: 1;

            // The pane's size. The placeholders below take part in the
            // layout, so it must not depend on the area's own size (a
            // binding loop): the splitter clamps it while dragging instead.
            property <length> pane-width: root.terminal-width;
            property <length> pane-height: root.terminal-height;
            property <bool> right-pane: root.terminal-visible && !root.terminal-bottom;
            property <bool> bottom-pane: root.terminal-visible && root.terminal-bottom;

            // The editor area fills what the pane leaves: placeholders
            // hold the pane's room on the right or at the bottom.
            VerticalLayout {
                HorizontalLayout {
                    vertical-stretch: 1;

                    if root.left-column-visible: LeftColumn {
                        width: 300px;
                        view: root.left-view;
                        problems: root.problems;
                        files: root.files;
                        changes: root.changes;
                        change-clicked(index) => {
                            root.change-clicked(index);
                        }
                        keep-change(index) => {
                            root.keep-change(index);
                        }
                        revert-change(index) => {
                            root.revert-change(index);
                        }
                        keep-all-changes => {
                            root.keep-all-changes();
                        }
                        revert-all-changes => {
                            root.revert-all-changes();
                        }
                        search-query: root.search-query;
                        search-regex: root.search-regex;
                        search-case-sensitive: root.search-case-sensitive;
                        search-whole-word: root.search-whole-word;
                        search-rows: root.search-rows;
                        search-status: root.search-status;
                        search-status-error: root.search-status-error;
                        has-usages: root.has-usages;
                        usages-title: root.usages-title;
                        usages-status: root.usages-status;
                        usages-rows: root.usages-rows;
                        usage-clicked(index) => {
                            root.usage-clicked(index);
                        }
                        show(view) => {
                            root.show-view(view);
                        }
                        problem-clicked(index) => {
                            root.problem-clicked(index);
                        }
                        file-clicked(index) => {
                            root.file-clicked(index);
                        }
                        search(text, regex, case-sensitive, whole-word) => {
                            root.search(text, regex, case-sensitive, whole-word);
                        }
                        search-result-clicked(index) => {
                            root.search-result-clicked(index);
                        }
                        scripts: root.scripts;
                        script-clicked(index) => {
                            root.script-clicked(index);
                        }
                    }

                    if root.left-column-visible: Rectangle {
                        width: 1px;
                        background: Theme.chrome-border;
                    }

                    left := EditorPane {
                        horizontal-stretch: 1;
                        tabs: root.left-tabs;
                        focused: root.focused-pane == 0;
                        has-editor: root.left-has-editor;
                        can-split: root.can-split;
                        geometry: root.left-geometry;
                        hunk: root.left-hunk;
                        quick-fixes: root.left-quick-fixes;
                        quick-fix-clicked(index) => {
                            root.quick-fix-clicked(index);
                        }
                        assist: root.left-assist;
                        completion-clicked(index) => {
                            root.completion-clicked(index);
                        }
                        pointer-moved(x, y) => {
                            root.pointer-moved(0, x, y);
                        }
                        pointer-left => {
                            root.pointer-left(0);
                        }
                        rollback-hunk => {
                            root.rollback-hunk();
                        }
                        hide-hunk => {
                            root.hide-hunk();
                        }
                        conflict: root.left-conflict;
                        conflict-resolved(reload) => {
                            root.conflict-resolved(0, reload);
                        }
                        tab-clicked(index) => {
                            root.tab-clicked(0, index);
                        }
                        tab-closed(index) => {
                            root.tab-closed(0, index);
                        }
                        tab-moved(index) => {
                            root.tab-moved(0, index);
                        }
                        split-right => {
                            root.split-right();
                        }
                        scrolled(delta-y) => {
                            root.scrolled(0, delta-y);
                        }
                        pressed(x, y, shift, alt) => {
                            root.pressed(0, x, y, shift, alt);
                        }
                        dragged(x, y) => {
                            root.dragged(0, x, y);
                        }
                        double-clicked(x, y) => {
                            root.double-clicked(0, x, y);
                        }
                        key(text, shift, cmd, alt, ctrl) => {
                            root.key(text, shift, cmd, alt, ctrl);
                        }
                        committed(text) => {
                            root.committed(text);
                        }
                        preedit-changed(text) => {
                            root.preedit-changed(text);
                        }
                    }

                    Rectangle {
                        width: 1px;
                        background: Theme.chrome-border;
                        visible: root.split;
                    }

                    right := EditorPane {
                        horizontal-stretch: 1;
                        visible: root.split;
                        tabs: root.right-tabs;
                        focused: root.focused-pane == 1;
                        has-editor: root.right-has-editor;
                        can-split: root.can-split;
                        geometry: root.right-geometry;
                        hunk: root.right-hunk;
                        quick-fixes: root.right-quick-fixes;
                        quick-fix-clicked(index) => {
                            root.quick-fix-clicked(index);
                        }
                        assist: root.right-assist;
                        completion-clicked(index) => {
                            root.completion-clicked(index);
                        }
                        pointer-moved(x, y) => {
                            root.pointer-moved(1, x, y);
                        }
                        pointer-left => {
                            root.pointer-left(1);
                        }
                        rollback-hunk => {
                            root.rollback-hunk();
                        }
                        hide-hunk => {
                            root.hide-hunk();
                        }
                        conflict: root.right-conflict;
                        conflict-resolved(reload) => {
                            root.conflict-resolved(1, reload);
                        }
                        tab-clicked(index) => {
                            root.tab-clicked(1, index);
                        }
                        tab-closed(index) => {
                            root.tab-closed(1, index);
                        }
                        tab-moved(index) => {
                            root.tab-moved(1, index);
                        }
                        split-right => {
                            root.split-right();
                        }
                        scrolled(delta-y) => {
                            root.scrolled(1, delta-y);
                        }
                        pressed(x, y, shift, alt) => {
                            root.pressed(1, x, y, shift, alt);
                        }
                        dragged(x, y) => {
                            root.dragged(1, x, y);
                        }
                        double-clicked(x, y) => {
                            root.double-clicked(1, x, y);
                        }
                        key(text, shift, cmd, alt, ctrl) => {
                            root.key(text, shift, cmd, alt, ctrl);
                        }
                        committed(text) => {
                            root.committed(text);
                        }
                        preedit-changed(text) => {
                            root.preedit-changed(text);
                        }
                    }

                    if content.right-pane: Rectangle {
                        width: content.pane-width + 5px;
                    }
                }

                if content.bottom-pane: Rectangle {
                    height: content.pane-height + 5px;
                }
            }

            // The splitter: drag it to share the window between the editor
            // area and the terminal.
            if root.terminal-visible: Rectangle {
                x: content.right-pane ? content.width - content.pane-width - 5px : 0px;
                y: content.bottom-pane ? content.height - content.pane-height - 5px : 0px;
                width: content.right-pane ? 5px : content.width;
                height: content.bottom-pane ? 5px : content.height;

                Rectangle {
                    x: content.right-pane ? 2px : 0px;
                    y: content.bottom-pane ? 2px : 0px;
                    width: content.right-pane ? 1px : parent.width;
                    height: content.bottom-pane ? 1px : parent.height;
                    background: Theme.chrome-border;
                }

                TouchArea {
                    mouse-cursor: content.right-pane ? col-resize : row-resize;
                    moved => {
                        if self.pressed && content.right-pane {
                            root.terminal-width = clamp(
                                content.pane-width - (self.mouse-x - self.pressed-x),
                                160px,
                                max(160px, content.width - 320px));
                        } else if self.pressed {
                            root.terminal-height = clamp(
                                content.pane-height - (self.mouse-y - self.pressed-y),
                                80px,
                                max(80px, content.height - 120px));
                        }
                    }
                }
            }

            terminal := TerminalPane {
                x: content.bottom-pane ? 0px : content.width - self.width;
                y: content.bottom-pane ? content.height - self.height : 0px;
                width: !root.terminal-visible ? 0px : content.bottom-pane ? content.width : content.pane-width;
                height: content.bottom-pane ? content.pane-height : content.height;
                visible: root.terminal-visible;
                tabs: root.terminal-tabs;
                message: root.terminal-message;
                focused: root.terminal-focused;
                rows: root.terminal-rows;
                cursor: root.terminal-cursor;
                mouse-reporting: root.terminal-mouse-reporting;
                command-tab: root.terminal-command-tab;
                running: root.terminal-running;
                url: root.terminal-url;
                stop => {
                    root.stop-terminal-tab();
                }
                rerun => {
                    root.rerun-terminal-tab();
                }
                open-url => {
                    root.open-terminal-url();
                }
                focus-requested => {
                    root.terminal-focus();
                }
                tab-clicked(index) => {
                    root.terminal-tab-clicked(index);
                }
                tab-closed(index) => {
                    root.terminal-tab-closed(index);
                }
                new-tab => {
                    root.new-terminal-tab();
                }
                key(text, shift, cmd, alt, ctrl) => {
                    root.terminal-key(text, shift, cmd, alt, ctrl);
                }
                committed(text) => {
                    root.terminal-committed(text);
                }
                preedit-changed(text) => {
                    root.terminal-preedit-changed(text);
                }
                mouse(kind, button, x, y, shift, alt, ctrl, cmd) => {
                    root.terminal-mouse(kind, button, x, y, shift, alt, ctrl, cmd);
                }
                scrolled(delta-y, x, y) => {
                    root.terminal-scrolled(delta-y, x, y);
                }
            }
        }

        StatusBar {
            notice: root.status-notice;
            config-notice: root.status-config-notice;
            problems: root.status-problems;
            has-errors: root.status-has-errors;
            notice-action: root.status-notice-action;
            notice-action-clicked => {
                root.notice-action();
            }
            toolchain: root.status-toolchain;
            project-check: root.status-project-check;
            branch: root.status-branch;
            caret: root.status-caret;
            encoding: root.status-encoding;
            line-ending: root.status-line-ending;
            indentation: root.status-indentation;
            update: root.status-update;
            large-file: root.status-large-file;
            loading: root.status-loading;
            language-server: root.status-language-server;
            language-server-alert: root.status-language-server-alert;
            script-links: root.status-script-links;
            script-link-clicked(index) => {
                root.script-link-clicked(index);
            }
            restart-language-server => {
                root.restart-language-server();
            }
            update-clicked => {
                root.open-update();
            }
            show-problems => {
                root.show-view(LeftView.problems);
            }
        }
    }

    // A click outside the finder closes it.
    TouchArea {
        visible: root.finder-open;
        clicked => {
            root.finder-close();
        }
    }

    finder := Finder {
        visible: root.finder-open;
        width: min(640px, root.width - 40px);
        height: min(420px, root.height - 80px);
        x: (root.width - self.width) / 2;
        y: 48px;
        title: root.finder-title;
        items: root.finder-items;
        selected: root.finder-selected;
        edited(text) => {
            root.finder-edited(text);
        }
        move(by) => {
            root.finder-move(by);
        }
        choose => {
            root.finder-accept();
        }
        close => {
            root.finder-close();
        }
        clicked(index) => {
            root.finder-clicked(index);
        }
    }

    // A click outside the rename prompt cancels it.
    if root.rename-open: TouchArea {
        clicked => {
            root.rename-cancelled();
        }
    }

    if root.rename-open: RenamePrompt {
        x: (root.width - self.width) / 2;
        y: 48px;
        width: min(420px, root.width - 40px);
        name: root.rename-name;
        init => {
            self.focus-name();
        }
        accepted(name) => {
            root.rename-accepted(name);
        }
        cancelled => {
            root.rename-cancelled();
        }
    }

    // A click outside the picker closes it.
    if root.picker-visible: TouchArea {
        clicked => {
            root.picker-cancelled();
        }
    }

    if root.picker-visible: ToolchainPicker {
        x: (root.width - self.width) / 2;
        y: 40px;
        width: min(440px, root.width - 32px);
        height: min(440px, root.height - 80px);
        title: root.picker-title;
        message: root.picker-message;
        loading: root.picker-loading;
        options: root.picker-options;
        init => {
            self.focus-filter();
        }
        filter-edited(text) => {
            root.picker-filter-edited(text);
        }
        picked(index) => {
            root.picker-picked(index);
        }
        cancelled => {
            root.picker-cancelled();
        }
    }
}
